# All of these are public website configuration, not secrets.
# Leave unknown values empty. No API Key belongs in this website.
PUBLIC_SITE_URL=
# Origin only above; project site uses /repository-name, custom domain uses /.
# GitHub Actions obtains both from configure-pages automatically.
PUBLIC_BASE_PATH=/
PUBLIC_HOSTING_PROVIDER=
PUBLIC_GITHUB_URL=https://github.com/shunyoudeng/luoxu-web
PUBLIC_GITHUB_RELEASES_URL=https://github.com/shunyoudeng/luoxu-web/releases
PUBLIC_FEEDBACK_EMAIL=luoxufeedback@163.com
PUBLIC_ICP_NUMBER=
PUBLIC_POLICE_RECORD=
PUBLIC_POLICE_RECORD_URL=
