---
import {withBase} from '../lib/urls';
import SiteLayout from '../layouts/SiteLayout.astro';
import history from '../data/history.json';
import {latest,formatDate} from '../lib/releases';
import desktop from '../../public/releases/desktop/latest.json';
const groups=[['added','新增'],['improved','改进'],['fixed','修复']] as const;
---
<SiteLayout scene="changelog" title="更新日志 — 珞序 LUOXU"><div class="wrap page-header"><p class="eyebrow">CHANGELOG / 持续维护</p><h1 data-split data-intro-chars>每一步，都留有记录。</h1><p>每个版本新增了什么、改进了什么、修好了什么。</p></div><div class="wrap release-history"><article class="release-entry" id="windows-v010"><div class="release-heading"><h2>Windows v{desktop.version}</h2><p>桌面增强 · 预览版<br/>发布于 {formatDate(desktop.releaseDate)}</p></div><div class="release-body"><h3>独立Windows客户端，连接自己的QQ消息来源。</h3><ul>{desktop.highlights.map(line=><li>{line}</li>)}</ul><p class="inline-note">需要自行运行并登录NapCat/OneBot，再在手机中扫码配对和选择群；手机通知仍可独立使用。</p><a class="text-link" href={withBase("/download")+"#windows"}>下载Windows客户端 →</a></div></article>{history.map(entry=>{const current=entry.id==='latest';const version=current?latest.version:entry.id;return <article class="release-entry" id={'v'+version.replaceAll('.','-')}><div class="release-heading"><h2>v{version}</h2><p>{current?latest.channel:entry.channel}<br/>{current?(latest.status==='candidate'?'预览 ':'发布于 ')+formatDate(latest.releaseDate||latest.buildDate):entry.period}</p>{current&&<span class="status">{latest.status==='candidate'?'预览版':'当前版本'}</span>}</div><div class="release-body"><h3>{entry.summary}</h3>{groups.map(([key,label])=>entry[key].length>0&&<section aria-label={label}><h4>{label}</h4><ul>{entry[key].map(item=><li>{item}</li>)}</ul></section>)}{entry.note&&<p class="inline-note">{entry.note}</p>}{current&&<a class="text-link" href={withBase("/download")}>下载与安装说明 →</a>}</div></article>})}</div></SiteLayout>
<style>.release-history{padding-bottom:var(--s24)}.release-entry{display:grid;grid-template-columns:240px 1fr;gap:var(--s16);padding-block:var(--s12);border-top:var(--stroke) solid var(--line)}.release-heading h2{font:400 var(--heading)/1.4 var(--serif)}.release-heading p{font-size:var(--small);color:var(--secondary);margin-top:var(--s4)}.release-heading .status{margin-top:var(--s4)}.release-body h3{font-size:var(--lead);font-weight:500;margin-bottom:var(--s6)}.release-body h4{font-size:var(--label);color:var(--green);font-weight:500;margin:var(--s6) 0 var(--s2)}.release-body ul{padding-left:var(--s5);margin:0;color:var(--secondary)}.release-body li{margin-block:var(--s2)}.release-body .inline-note{margin-top:var(--s6)}@media(max-width:700px){.release-entry{grid-template-columns:1fr;gap:var(--s6);padding-block:var(--s8)}.release-heading p{margin-top:var(--s2)}.release-heading h2{font-size:var(--heading)}}
</style>
