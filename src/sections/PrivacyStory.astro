---
import {withBase} from '../lib/urls';
import Icon from '../components/Icon.astro';
import GitHubLink from '../components/GitHubLink.astro';
---
<section class="chapter"><div class="wrap">
  <header class="chapter-head"><span class="eyebrow" data-layer="0">04 / LOCAL-FIRST</span><h2 class="disp" data-split><span class="soft">先留在手机，</span><br/><span class="accent">需要时再交给 AI。</span></h2><p data-layer="2">一个清楚的边界，比一个复杂的架构更重要。</p></header>
  <div class="architecture">
    <div class="architecture-local" data-layer="3" data-fx="left"><div class="node"><span class="eyebrow">YOUR PHONE</span><h3>你的手机</h3><p>已授权的通知与输入</p></div><span class="architecture-arrow" aria-hidden="true">→</span><div class="node"><span class="eyebrow">LOCAL DATABASE</span><h3>本地事务</h3><p>任务、画像与个人配置</p></div></div>
    <div class="architecture-cloud" data-layer="4" data-fx="right"><span class="connection-label">仅在需要分析时 →</span><div class="node node-cloud"><span class="eyebrow">YOUR AI PROVIDER</span><h3>你的模型服务</h3><p>必要的文字与上下文<br/>API Key 只在 App 中配置</p></div></div>
  </div>
  <p class="architecture-note" data-layer="5">官网只负责介绍、下载与版本信息，不接收你的 API Key。</p>
</div></section>

<section class="chapter chapter-last"><div class="wrap open-source">
  <div><p class="eyebrow" data-layer="0">05 / BUILT TO LAST</p><h2 class="disp" data-split><span class="os-1">本地优先。</span><span class="os-2">持续维护。</span><span class="os-3">官网源码开放。</span></h2></div>
  <div class="os-copy" data-layer="3"><p>把产品的边界、版本变化和使用方式说明白，也把维护留给长期。</p><p>官网与官网源码继续公开，Android 应用源码现阶段暂不公开。安装包和更新记录仍可正常获取。</p><GitHubLink/></div>
</div></section>
<style>
.architecture{display:grid;grid-template-columns:1.35fr 1fr;gap:var(--s8);align-items:stretch}
.architecture-local{display:flex;gap:var(--s6);align-items:center;justify-content:space-between;padding:clamp(24px,3vw,40px);border-radius:32px;background:var(--surface);border:var(--stroke) solid var(--line);box-shadow:var(--shadow-soft)}
.node h3{font-size:var(--title);font-weight:800;margin-top:var(--s3)}
.node p{font-size:var(--small);color:var(--secondary);margin-top:var(--s2)}
.architecture-arrow{color:var(--green);font-size:1.75rem}
.architecture-cloud{display:flex;gap:var(--s5);align-items:center}
.connection-label{font-size:var(--caption);color:var(--green);max-width:84px;line-height:1.5}
.node-cloud{flex:1;height:100%;display:flex;flex-direction:column;justify-content:center;padding:clamp(24px,3vw,40px);border-radius:32px;border:1.5px dashed var(--green-soft);background:var(--mist)}
.architecture-note{font-size:var(--small);color:var(--secondary);margin-top:var(--s8);text-align:center}

.chapter-last{padding-bottom:clamp(96px,12vw,176px)}
.open-source{display:grid;grid-template-columns:1.2fr 1fr;align-items:end;gap:var(--s16)}
.open-source h2{margin-top:var(--s5);font-size:clamp(2.25rem,6.2vw,5.25rem);line-height:1.12;font-weight:800;letter-spacing:-.03em}
.open-source h2 span{display:block}
.os-1{color:var(--ink)}.os-2{color:var(--secondary);font-weight:600}.os-3{font-family:var(--song);font-weight:900;color:var(--green)}
.os-copy p:not(.eyebrow){color:var(--secondary);max-width:34rem;margin-bottom:var(--s5)}
.os-copy{padding-bottom:var(--s3)}
@media(max-width:900px){.architecture{grid-template-columns:1fr}.architecture-local{justify-content:space-between}}
@media(max-width:700px){.privacy-copy,.open-source{grid-template-columns:1fr;gap:var(--s8)}.privacy-copy{margin-top:var(--s10)}.architecture-local{padding:var(--s6);gap:var(--s3)}.node h3{font-size:var(--body)}.node p{font-size:var(--caption)}.architecture-cloud{flex-direction:column;align-items:flex-start;gap:var(--s3)}.node-cloud{width:100%}.connection-label{max-width:none}.architecture-note{text-align:left}}
</style>
