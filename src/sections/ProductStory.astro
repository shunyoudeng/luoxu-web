---
import {withBase} from '../lib/urls';
import Icon from '../components/Icon.astro';
import ProductPreview from '../components/ProductPreview.astro';
const features=[
  {n:'01',title:'通知理解',size:'wide',body:'在你主动授权的 QQ、微信等系统通知里，理解内容和来源。系统没发出的通知，珞序无法凭空读取。'},
  {n:'02',title:'事务整理',size:'narrow',body:'需要亲自处理的是任务；课程里的练习和报告是作业。可选择参加的机会，与告知校园变化的信息，分别整理。'},
  {n:'03',title:'一屏周视图',size:'narrow',body:'用一周看清时间。临近截止的事项、未确定日期和长期事项，各有清楚的位置。'},
  {n:'04',title:'AI秘书',size:'wide',body:'问“这周还有什么作业”，也可以说“下午三点提醒我拿快递”。查询、创建和修改，放在自然对话里完成。'},
  {n:'05',title:'与你有关',size:'half',tint:true,body:'结合校园身份、角色、兴趣和关注目标判断相关性。AI判断有误时，你可以纠正。'},
  {n:'06',title:'由你掌握',size:'half',tint:true,body:'事务数据库与个人配置主要保存在自己的设备。监听哪些来源、什么时候暂停，由你选择。'}
];
const week=[38,62,46,88,54,30,22];
---
<section class="chapter preview-chapter"><div class="wrap preview-grid">
  <div class="preview-copy"><p class="eyebrow">02 / DAILY</p><h2 class="disp" data-split><span class="soft">从收到消息，</span><br/><span class="accent">到心里有数。</span></h2><p>把整理、时间和个人身份连在一起。不是再多一张需要自己填满的清单。</p><p class="muted">切换右侧标签，看四类事务如何各有位置。</p></div>
  <div class="preview-stage"><ProductPreview/></div>
</div></section>

<section class="chapter chapter-tint"><div class="wrap">
  <header class="chapter-head"><span class="eyebrow" data-layer="0">03 / CAPABILITIES</span><h2 class="disp" data-split><span class="soft">四件小事，</span><br/><span class="accent">一个有序的日常。</span></h2></header>
  <div class="bento">
    {features.map((f,i)=><article class:list={['bento-card',`bento-${f.size}`,{tint:f.tint}]} data-layer={3+(i%2)} data-mask data-tilt data-n={f.n}>
      <h3>{f.title}</h3><p>{f.body}</p>
      {f.n==='01'&&<div class="deco chips" aria-hidden="true"><span>QQ</span><span>微信</span><span>系统通知</span></div>}
      {f.n==='03'&&<div class="deco week" aria-hidden="true">{week.map((h,d)=><i style={`--h:${h}%;--d:${d}`}></i>)}</div>}
      {f.n==='04'&&<div class="deco chat kai" aria-hidden="true"><span>这周还有什么作业？</span><span class="me">下午三点提醒我拿快递</span></div>}
    </article>)}
  </div>
  <a class="text-link more-link" data-layer="6" href={withBase("/about")}>更多产品说明 <Icon/></a>
</div></section>
<style>


.bento{display:grid;grid-template-columns:repeat(6,1fr);gap:var(--s4)}
.bento-card{position:relative;overflow:hidden;display:flex;flex-direction:column;gap:var(--s3);padding:clamp(24px,3vw,40px);min-height:300px;border-radius:32px;background:var(--surface);border:var(--stroke) solid var(--line);box-shadow:var(--shadow-soft)}
.bento-wide{grid-column:span 4}.bento-narrow{grid-column:span 2}.bento-half{grid-column:span 3;min-height:240px}
.bento-card.tint{background:var(--mist);box-shadow:none}
.bento-card::before{content:attr(data-n);font:italic 400 clamp(2.75rem,5vw,4.5rem)/1 var(--serif);color:var(--green);opacity:.28;margin-bottom:auto;padding-bottom:var(--s8)}
.bento-card h3{font-size:clamp(1.5rem,2.4vw,2rem);font-weight:800;letter-spacing:-.015em;line-height:1.25}
.bento-card p{color:var(--secondary);max-width:30rem}
.bento-wide h3{font-size:clamp(1.75rem,3vw,2.5rem)}
.deco{position:absolute;right:clamp(20px,3vw,40px);top:clamp(24px,3vw,40px)}
.chips{display:flex;gap:var(--s2);flex-wrap:wrap;justify-content:flex-end;max-width:60%}
.chips span{font-size:var(--caption);padding:var(--s1) var(--s3);border-radius:999px;border:var(--stroke) solid var(--line);color:var(--green);background:var(--paper)}
.week{display:flex;align-items:flex-end;gap:6px;height:72px}
.week i{display:block;width:10px;height:var(--h);border-radius:5px;background:var(--green);opacity:.18}
.week i:nth-child(4){opacity:.9}
.chat{display:flex;flex-direction:column;gap:var(--s2);align-items:flex-end;font-size:var(--small)}
.chat span{padding:var(--s2) var(--s4);border-radius:18px 18px 18px 4px;background:var(--mist);color:var(--ink)}
.chat .me{border-radius:18px 18px 4px 18px;background:var(--green);color:var(--paper)}
.more-link{margin-top:var(--s8);justify-content:center;width:100%}

@media(max-width:900px){.flow{grid-template-columns:1fr;gap:var(--s6)}.flow-understand{text-align:left;max-width:240px;margin-left:var(--s4)}.flow-path{background:linear-gradient(90deg,var(--green),transparent);width:80px}.bento-wide,.bento-narrow{grid-column:span 3}.chips{position:static;max-width:none;justify-content:flex-start;margin-top:var(--s2)}.deco.chat,.deco.week{position:static;align-items:flex-start;margin-top:var(--s4)}}
@media(max-width:700px){.bento{grid-template-columns:1fr}.bento-wide,.bento-narrow,.bento-half{grid-column:auto;min-height:0}.bento-card::before{padding-bottom:var(--s4)}.bento-card{border-radius:26px}.message-example,.flow-result{padding:var(--s6);border-radius:24px}.message-example p{font-size:1.25rem}.categories span{font-size:1.25rem;padding:var(--s3) var(--s4)}.chapter-head{text-align:left;align-items:flex-start}}
.preview-grid{display:grid;grid-template-columns:1fr minmax(0,420px);gap:clamp(32px,8vw,128px);align-items:center}
.preview-copy{display:flex;flex-direction:column;gap:var(--s5)}
.preview-copy p:not(.eyebrow){color:var(--secondary);max-width:28rem;font-size:var(--lead)}
.preview-stage{will-change:transform}
@media(max-width:900px){.preview-grid{grid-template-columns:1fr}.preview-stage{max-width:380px;margin-inline:auto;width:100%}}
</style>
