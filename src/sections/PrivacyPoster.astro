---
import {withBase} from '../lib/urls';
import Icon from '../components/Icon.astro';
interface Props {heading?:'h1'|'h2';copy?:boolean}
const {heading='h2',copy=true}=Astro.props;
const H=heading;
---
<section class="privacy-story" data-tone="dark">
  <div class="poster" aria-labelledby="poster-title">
    <div class="poster-sticky">
      <p class="eyebrow poster-eyebrow">03 / YOUR LIFE, YOURS.</p>
      <H id="poster-title" class="poster-h">
        <span class="poster-line l1 kai" data-split-poster>你的校园生活，</span>
        <span class="poster-line l2" data-split-poster>不应该成为</span>
        <span class="poster-line l3" data-split-poster>任何人的</span>
        <span class="poster-line l4"><span class="strike-target" data-split-poster>数据库。</span><span class="strike" aria-hidden="true"></span></span>
      </H>
      <p class="poster-tail">珞序只想帮你整理，<br class="m-br"/>而不是占有。</p>
    </div>
  </div>
  {copy&&<div class="wrap privacy-copy">
    <p class="privacy-pull">真正有用的智能，不该以过度收集为代价。<br/>珞序希望帮助你整理生活中的秩序，而不是占有它。</p>
    <div><p>事务与配置主要保存在你的设备。官网不建立用户通知、群聊、任务或 AI 对话数据库。</p><p>需要 AI 理解时，相关内容与必要上下文会发送到你配置的模型服务。目前支持 DeepSeek API；这不意味着所有数据都不离开设备。</p><a class="text-link" href={withBase("/privacy")}>把隐私说明说清楚 <Icon/></a></div>
  </div>}
</section>
<style>
.privacy-story{color:var(--on-night);position:relative;overflow:clip;background:var(--night)}
html.webgl .privacy-story{background:transparent linear-gradient(rgba(22,35,29,0),rgba(22,35,29,0))}
.privacy-story .eyebrow{color:var(--on-night-2)}
.privacy-story :focus-visible{outline-color:var(--mint)}
.poster{position:relative;height:420svh}
.poster-sticky{position:sticky;top:0;height:100svh;min-height:600px;overflow:clip;display:flex;flex-direction:column;justify-content:center;padding:calc(72px + 2vh) clamp(20px,4vw,64px) var(--s8)}
.poster-eyebrow{position:absolute;left:clamp(20px,4vw,64px);top:calc(72px + 4vh)}
.poster-h{position:relative;font-weight:900;letter-spacing:-.05em;line-height:.98;perspective:1100px;transform-style:preserve-3d}
.poster-line{display:block;color:var(--on-night);font:900 clamp(3rem,12.4vw,12.5rem)/1 var(--display-font);will-change:transform}
.poster-line.l1{font:400 clamp(1.4rem,3.2vw,3rem)/1.4 var(--kai);letter-spacing:.06em;color:var(--mint);margin-bottom:.4em}
.poster-line.l2{margin-left:-.02em}
.poster-line.l3{margin-left:clamp(0px,9vw,150px);color:var(--mint)}
.poster-line.l4{position:relative;width:max-content;max-width:100%;margin-left:clamp(0px,3vw,60px)}
.poster-line .ch{display:inline-block;overflow:hidden;vertical-align:top;padding-bottom:.08em;margin-bottom:-.08em}
.poster-line .ci{display:inline-block}
.strike-target{display:inline-block}
.strike{position:absolute;left:-.02em;right:0;top:54%;height:.075em;background:var(--mint);transform-origin:left;transform:scaleX(0);border-radius:4px}
html:not(.js) .strike{transform:none}
.poster-tail{position:absolute;left:clamp(20px,4vw,64px);bottom:clamp(36px,9vh,90px);max-width:18em;font:400 clamp(1.15rem,2.4vw,2rem)/1.5 var(--kai);color:var(--on-night);letter-spacing:.04em;opacity:0;transform:translateY(24px)}
html:not(.js) .poster-tail{opacity:1;transform:none}
.m-br{display:none}
.privacy-copy{display:grid;grid-template-columns:1fr 1fr;gap:var(--s16);padding-block:clamp(48px,7vw,96px) clamp(96px,12vw,176px);border-top:var(--stroke) solid rgba(241,243,236,.16)}
.privacy-copy p{color:var(--on-night-2);max-width:34rem}
.privacy-copy p+p{margin-top:var(--s4)}
.privacy-pull{font-family:var(--kai);font-size:clamp(1.25rem,2vw,1.625rem);line-height:1.8;color:var(--on-night)!important}
.privacy-story .text-link{color:var(--mint);margin-top:var(--s4)}
.privacy-story .text-link:hover{color:#fff}
html:not(.js) .poster{height:auto}html:not(.js) .poster-sticky{position:static;height:auto;padding-block:var(--s24)}
@media(max-width:700px){.poster{height:360svh}.privacy-copy{grid-template-columns:1fr;gap:var(--s8)}.poster-line{font-size:clamp(3rem,19vw,6rem)}.poster-line.l3{margin-left:.5em}.m-br{display:inline}.poster-tail{bottom:calc(env(safe-area-inset-bottom) + 36px)}}
@media(prefers-reduced-motion:reduce){.poster{height:auto}.poster-sticky{position:static;height:auto;padding-block:var(--s24)}.poster-tail{opacity:1;transform:none}.strike{transform:none}}
</style>
