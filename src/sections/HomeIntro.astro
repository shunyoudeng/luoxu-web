---
import {withBase} from '../lib/urls';
import ProductPreview from '../components/ProductPreview.astro';
import GitHubLink from '../components/GitHubLink.astro';
import Icon from '../components/Icon.astro';
import {latest} from '../lib/releases';
---
<section class="hero"><div class="wrap hero-grid"><div class="hero-copy"><p class="eyebrow">LUOXU / YOUR CAMPUS, IN ORDER.</p><h1>让消息各归其位，<br/>让校园生活<br class="mobile-break"/>自成秩序。</h1><p class="hero-description">珞序是一款本地优先的校园 AI 助手。<br/>从通知与群聊中理出重点，整理成清楚的任务、作业、机会和校园信息。</p><div class="actions"><a class="button primary" href={withBase("/download")}>下载 Android 公测版 <Icon name="download"/></a><GitHubLink/></div><p class="hero-version">v{latest.version} · {latest.channel} · 公测开放</p><div class="hero-footnote"><span class="quiet-line" aria-hidden="true"></span><span>少读一点消息，多留一点时间给自己。</span></div></div><div class="hero-product"><svg class="landscape" viewBox="0 0 440 240" fill="none" aria-hidden="true"><path d="M2 184C54 182 44 136 88 134C129 133 120 85 164 86C212 86 222 159 261 156C300 154 297 116 335 119C376 123 378 174 438 177M2 211C76 205 109 218 181 208C256 198 350 219 438 207" stroke="currentColor" stroke-width="1"/></svg><ProductPreview/></div></div></section>
<style>.hero{padding-block:var(--s16);position:relative}.hero-grid{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(0,1fr);align-items:center;gap:var(--s16)}.hero-copy h1{margin-block:var(--s6);font-size:clamp(2rem,3.65vw,var(--display))}.mobile-break{display:none}.hero-description{max-width:36rem;font-size:var(--lead);color:var(--secondary)}.hero-copy .actions{margin-top:var(--s8)}.hero-version{font-size:var(--caption);color:var(--secondary);margin-top:var(--s4)}.hero-footnote{display:flex;align-items:center;gap:var(--s4);margin-top:var(--s12);font-size:var(--small);color:var(--secondary)}.quiet-line{width:var(--s8);height:var(--stroke);background:var(--line)}.hero-product{position:relative}.landscape{position:absolute;width:100%;left:0;top:var(--s12);color:var(--line);z-index:-1}@media(max-width:900px){.hero-grid{gap:var(--s8)}.hero-description{font-size:var(--body)}.hero-copy h1{font-size:var(--heading)}.hero-copy .actions{align-items:flex-start;flex-direction:column}}@media(max-width:700px){.hero{padding-block:var(--s12)}.hero-grid{grid-template-columns:1fr;gap:var(--s10)}.hero-copy h1{font-size:var(--display);margin-block:var(--s5)}.hero-copy .actions{flex-direction:row}.hero-footnote{margin-top:var(--s8)}.mobile-break{display:block}.hero-product{max-width:380px;width:100%;margin-inline:auto}.landscape{display:none}}</style>
