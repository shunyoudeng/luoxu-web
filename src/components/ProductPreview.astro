---
const categories=[{key:'task',label:'任务',heading:'今天需要处理',items:[['15:00','拿快递','今天 · 未完成'],['18:00','提交团日活动材料','PDF + 3张活动照片']]},{key:'assignment',label:'作业',heading:'学习上的几件事',items:[['20:00','高等数学作业','学习通 · 今晚截止 · 待提交'],['周五','大学物理实验报告','课程作业 · 截止前一天提醒']]},{key:'opportunity',label:'机会',heading:'值得你留意',items:[['10.15','大学生创新竞赛报名','与你的科创兴趣相关'],['本周','实验室本科生招募','可选择参加 · 科研']]},{key:'info',label:'校园信息',heading:'校园里的变化',items:[['23:00','工学部今晚停水','至次日06:00 · 工学部'],['周六','图书馆开放时间调整','关注开放时间变化']]}];
// App bottom bar (v0.8.0): 首页 / 日程 / AI秘书 / 我的, line icons drawn in-project.
const bar=[{label:'首页',d:'M4 10.5 12 4l8 6.5V19a1 1 0 0 1-1 1h-4.5v-5.5h-5V20H5a1 1 0 0 1-1-1z'},{label:'日程',d:'M5 6.5h14a1 1 0 0 1 1 1V19a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7.5a1 1 0 0 1 1-1zM4 10.5h16M8.5 4v4M15.5 4v4'},{label:'AI秘书',d:'M12 4.5c.6 3.6 2.4 5.4 6 6-3.6.6-5.4 2.4-6 6-.6-3.6-2.4-5.4-6-6 3.6-.6 5.4-2.4 6-6zM18.5 16.5c.25 1.3.9 1.95 2.2 2.2-1.3.25-1.95.9-2.2 2.2-.25-1.3-.9-1.95-2.2-2.2 1.3-.25 1.95-.9 2.2-2.2z'},{label:'我的',d:'M12 12a3.75 3.75 0 1 0 0-7.5A3.75 3.75 0 0 0 12 12zM4.75 20c.6-3.6 3.6-5.75 7.25-5.75s6.65 2.15 7.25 5.75'}];
---
<div class="product-preview" data-preview><div class="preview-tabs" role="tablist" aria-label="查看四类事务功能示意"><span class="seg-lens" aria-hidden="true"></span>{categories.map((c,i)=><button type="button" id={'tab-'+c.key} role="tab" aria-selected={i===0?'true':'false'} aria-controls={'panel-'+c.key} tabindex={i===0?0:-1} data-key={c.key}><span class="seg-label">{c.label}</span><span class="seg-sizer" aria-hidden="true">{c.label}</span></button>)}</div>
<div class="device"><div class="device-top"><span>09:41</span><span class="device-island" aria-hidden="true"></span><span>功能示意</span></div><div class="device-brand"><span class="song">珞序</span><small>LUOXU</small><span class="device-date">10 / 14</span><span class="device-inbox" title="数据箱">数据箱<b>2</b></span></div><p class="device-phrase kai">山色有远近，今日有轻重。</p>
<div class="preview-panels">{categories.map((c,i)=><div id={'panel-'+c.key} role="tabpanel" aria-labelledby={'tab-'+c.key} tabindex="0" hidden={i!==0}><h3>{c.heading}</h3>{c.items.map(([time,title,note],j)=><div class:list={['preview-item',{focus:j===0}]}><span class="item-time">{time}</span><div><h4>{title}</h4><p>{note}</p></div></div>)}<div class="preview-assistant"><span>珞序</span><p>{c.key==='task'?'“有什么快截止了？”':c.key==='assignment'?'“这周还有什么作业？”':c.key==='opportunity'?'“最近有哪些科研竞赛？”':'“今天校园有什么变化？”'}</p></div></div>)}
</div><div class="device-peek" aria-hidden="true"><i></i><span><b></b><b></b></span></div><div class="device-bottom"><span class="bar-lens" aria-hidden="true"></span>{bar.map((b,i)=><span class:list={['bar-item',{on:i===0}]}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d={b.d}/></svg>{b.label}</span>)}</div></div><p class="preview-caption">功能示意 · 非当前版本截图</p></div>
<script>
import {Spring} from '../scripts/liquid-spring';
// Leading edge: quick and a little bouncy. Trailing edge: softer, so the lens stretches toward its target,
// then the leading edge's overshoot and the trailing edge's catch-up give the elastic settle.
const LEAD={stiffness:430,damping:26}, TRAIL={stiffness:190,damping:24};
const reduced=matchMedia('(prefers-reduced-motion: reduce)');

function setup(preview:HTMLElement){
  const track=preview.querySelector<HTMLElement>('[role=tablist]'), lens=preview.querySelector<HTMLElement>('.seg-lens');
  if(!track||!lens)return;
  const tabs=Array.from(track.querySelectorAll<HTMLButtonElement>('[role=tab]'));
  const left=new Spring(0,LEAD), right=new Spring(0,TRAIL), press=new Spring(0,{stiffness:520,damping:30});
  let current=Math.max(0,tabs.findIndex(t=>t.getAttribute('aria-selected')==='true')), frame=0;
  // Layout coordinates (offsetLeft) stay correct even while an ancestor is transformed by scroll motion.
  const edges=(i:number)=>{const t=tabs[i];return [t.offsetLeft,t.offsetLeft+t.offsetWidth] as const;};
  const bounds=()=>[tabs[0].offsetLeft,tabs[tabs.length-1].offsetLeft+tabs[tabs.length-1].offsetWidth] as const;
  // Past the track's inner edge the lens meets resistance instead of a wall: a rubber band, not a clip.
  const band=(x:number,min:number,max:number)=>x<min?min-(min-x)*.3:x>max?max+(x-max)*.3:x;
  const paint=()=>{
    const [min,max]=bounds(), [tl,tr]=edges(current);
    const l=band(left.value,min,max), r=Math.max(l,band(right.value,min,max)), w=r-l, rest=tr-tl;
    // Stretched glass thins a little, like a drop pulled along a surface.
    const stretch=Math.min(1,Math.max(0,(w-rest)/rest)), p=press.value;
    lens.style.width=`${w}px`;
    lens.style.transform=`translate3d(${l}px,0,0) scale(${1+.045*p},${(1-.1*stretch)*(1+.06*p)})`;
  };
  const loop=(now:number)=>{const a=left.tick(now), b=right.tick(now), c=press.tick(now);paint();frame=a||b||c?requestAnimationFrame(loop):0;};
  const run=()=>{if(!frame)frame=requestAnimationFrame(loop);};
  const snap=()=>{const [l,r]=edges(current);left.jump(l);right.jump(r);press.jump(press.target);paint();};
  const moveTo=(i:number)=>{
    const [l,r]=edges(i);
    if(reduced.matches||!track.classList.contains('is-live')){snap();return;}
    // Whichever edge faces the target leads; re-evaluated on every change, so an interruption flows on.
    const forward=(l+r)/2>=(left.value+right.value)/2;
    (forward?right:left).configure(LEAD);(forward?left:right).configure(TRAIL);
    left.setTarget(l);right.setTarget(r);run();
  };
  const select=(i:number)=>{
    tabs.forEach((t,j)=>{const on=j===i;t.setAttribute('aria-selected',String(on));t.tabIndex=on?0:-1;const panel=document.getElementById(t.getAttribute('aria-controls')||'');if(panel)panel.hidden=!on;});
    current=i;moveTo(i);
  };
  tabs.forEach((tab,index)=>{
    tab.addEventListener('click',()=>select(index));
    tab.addEventListener('keydown',event=>{let next=index;if(event.key==='ArrowRight')next=(index+1)%tabs.length;else if(event.key==='ArrowLeft')next=(index-1+tabs.length)%tabs.length;else if(event.key==='Home')next=0;else if(event.key==='End')next=tabs.length-1;else return;event.preventDefault();select(next);tabs[next].focus();});
  });
  // Touch-down swells the glass (never darkens a rectangle); release lets it settle back.
  const down=(e:PointerEvent)=>{if(e.button||reduced.matches)return;press.setTarget(1);run();};
  const up=()=>{press.setTarget(0);run();};
  track.addEventListener('pointerdown',down);
  ['pointerup','pointercancel','pointerleave'].forEach(type=>track.addEventListener(type,up));
  // Fonts, resizes and zoom change tab widths: follow without animating.
  new ResizeObserver(()=>{if(!frame)snap();}).observe(track);
  snap();track.classList.add('is-live');
}

// re-run on every page view: with client-side navigation the module itself executes only once
document.addEventListener('astro:page-load',()=>{
  const preview=document.querySelector<HTMLElement>('[data-preview]');
  if(preview&&!preview.dataset.ready){preview.dataset.ready='true';setup(preview);}
});
</script>
<style>
.product-preview{width:100%;max-width:372px;margin-inline:auto;text-align:left}

/* Segmented control: light translucent track, one raised white glass lens. */
.preview-tabs{position:relative;isolation:isolate;display:flex;padding:3px;margin:0 auto var(--s6);width:fit-content;max-width:100%;border-radius:999px;background:rgba(38,53,45,.05);box-shadow:inset 0 0 0 .5px rgba(38,53,45,.05),inset 0 1px 2px rgba(38,53,45,.05);-webkit-backdrop-filter:blur(16px) saturate(160%);backdrop-filter:blur(16px) saturate(160%)}
.seg-lens{position:absolute;z-index:0;top:3px;bottom:3px;left:0;width:0;border-radius:999px;pointer-events:none;opacity:0;transform-origin:center;will-change:transform,width;background:linear-gradient(180deg,#fff 0%,rgba(255,254,251,.94) 100%);box-shadow:0 0 0 .5px rgba(38,53,45,.07),0 3px 8px -1px rgba(38,53,45,.14),0 1px 2px rgba(38,53,45,.06),inset 0 1px 0 #fff,inset 0 -1px 1px rgba(38,53,45,.025)}
.preview-tabs.is-live .seg-lens{opacity:1}
.preview-tabs button{position:relative;z-index:1;display:inline-grid;place-items:center;border:0;background:none;min-height:40px;padding:0 var(--s4);font-size:var(--label);font-weight:500;color:#55615A;border-radius:999px;white-space:nowrap;-webkit-tap-highlight-color:transparent}
/* label and its semibold twin share one cell, so selecting never changes a tab's width */
.seg-label,.seg-sizer{grid-area:1/1}
.seg-sizer{font-weight:600;visibility:hidden}
.preview-tabs [role=tab][aria-selected=true]{color:var(--ink)}
.preview-tabs [aria-selected=true] .seg-label{font-weight:600}
/* No JS: the selected tab carries the glass itself. */
.preview-tabs:not(.is-live) [aria-selected=true]{background:#fff;box-shadow:0 0 0 .5px rgba(38,53,45,.07),0 3px 8px -1px rgba(38,53,45,.14)}
.preview-tabs button:focus-visible{outline-offset:-1px}

.device{position:relative;overflow:hidden;background:linear-gradient(180deg,var(--surface),#FAF9F4);border:var(--stroke) solid var(--line);border-radius:40px;padding:var(--s6) var(--s6) 96px;min-height:480px;box-shadow:var(--shadow-lift),inset 0 0 0 6px rgba(255,254,251,.9),inset 0 0 0 7px var(--line)}
.preview-panels{display:grid}
.preview-panels > [role=tabpanel]{grid-area:1/1;min-width:0;opacity:1;transition:opacity var(--motion-emphasized) var(--ease-out)}
.preview-panels > [hidden]{display:block;visibility:hidden;pointer-events:none;opacity:0;transition:none}
.device-top{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;font:var(--caption) var(--serif);font-variant-numeric:tabular-nums;color:var(--secondary);margin:var(--s1) var(--s2) var(--s6)}
.device-top span:last-child{text-align:right}
.device-island{width:64px;height:20px;border-radius:999px;background:var(--ink)}
.device-brand{display:flex;gap:var(--s3);align-items:baseline;font-size:1.75rem;font-weight:800;line-height:1.2;padding-inline:var(--s2)}
.device-brand .song{font-weight:900}
.device-brand small{font:italic var(--caption) var(--serif);letter-spacing:.14em;color:var(--green)}
.device-date{margin-left:auto;font:italic 400 var(--title) var(--serif);color:var(--green)}
.device-inbox{align-self:center;display:inline-flex;align-items:center;gap:var(--s1);font:500 var(--caption) var(--sans,inherit);color:var(--secondary);border:var(--stroke) solid var(--line);border-radius:999px;padding:2px var(--s2)}
.device-inbox b{min-width:16px;height:16px;border-radius:999px;background:var(--green);color:var(--paper);font-size:.6875rem;line-height:16px;text-align:center}
.device-phrase{font-size:var(--small);color:var(--secondary);margin-top:var(--s2);padding-inline:var(--s2)}
[role=tabpanel] h3{font-size:var(--small);font-weight:600;letter-spacing:.04em;margin-block:var(--s6) var(--s3);padding-inline:var(--s2)}
.preview-item{display:flex;align-items:flex-start;gap:var(--s4);padding:var(--s3) var(--s4);border-radius:var(--r3);margin-bottom:var(--s1)}
.preview-item.focus{background:var(--mist)}
.item-time{font:italic var(--small)/1.7 var(--serif);font-variant-numeric:tabular-nums;color:var(--green);min-width:44px}
.preview-item h4{font-size:var(--small);font-weight:600;margin:0}
.preview-item p{font-size:var(--caption);color:var(--secondary);margin-top:var(--s1)}
.preview-assistant{margin-top:var(--s5);margin-inline:var(--s2);padding:var(--s3) var(--s4);border-radius:var(--r3) var(--r3) var(--r3) var(--s1);background:var(--green);color:var(--paper);font-size:var(--caption)}
.preview-assistant span{font-family:var(--song);font-weight:900;color:var(--mint)}
.preview-assistant p{margin-top:var(--s1);color:var(--paper);font-size:var(--small)}

/* The list keeps going under the bar: what the frosted capsule floats over. */
.device-peek{position:absolute;left:calc(var(--s6) + var(--s2));right:var(--s10);bottom:30px;display:flex;align-items:center;gap:var(--s4);height:34px;opacity:.75}
.device-peek i{width:34px;height:9px;border-radius:999px;background:rgba(36,93,80,.32)}
.device-peek span{flex:1;display:grid;gap:7px}
.device-peek b{display:block;height:8px;border-radius:999px;background:rgba(38,53,45,.2)}
.device-peek b+b{width:62%;background:rgba(38,53,45,.11)}

/* Floating glass capsule: blur + saturation, paper tint, white top rim, soft shadow. */
.device-bottom{position:absolute;left:14px;right:14px;bottom:14px;display:grid;grid-template-columns:repeat(4,1fr);padding:5px;height:62px;border-radius:999px;font-size:.6875rem;line-height:1.2;color:var(--secondary);background:linear-gradient(180deg,rgba(255,255,255,.7),rgba(255,254,251,.52));-webkit-backdrop-filter:blur(14px) saturate(180%);backdrop-filter:blur(14px) saturate(180%);box-shadow:0 0 0 .5px rgba(38,53,45,.08),0 14px 30px -14px rgba(23,58,49,.34),0 3px 8px -4px rgba(23,58,49,.14),inset 0 1px 0 rgba(255,255,255,.95),inset 0 -1px 1px rgba(255,255,255,.4)}
.bar-lens{position:absolute;top:5px;bottom:5px;left:5px;width:calc((100% - 10px) / 4);border-radius:999px;background:linear-gradient(180deg,rgba(36,93,80,.085),rgba(36,93,80,.12));box-shadow:inset 0 0 0 .5px rgba(36,93,80,.06),inset 0 1px 0 rgba(255,255,255,.7)}
.bar-item{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;white-space:nowrap}
.bar-item svg{fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.bar-item.on{color:var(--green);font-weight:600}
.bar-item.on svg{stroke-width:1.9}

.preview-caption{margin-top:var(--s4);font-size:var(--caption);color:var(--secondary);text-align:center;letter-spacing:.04em}
/* Matches v3.css: no live backdrop sampling on phones (the 3D field repaints every frame); denser glass instead. */
@media(max-width:900px),(pointer:coarse){.device-bottom{-webkit-backdrop-filter:none;backdrop-filter:none;background:linear-gradient(180deg,rgba(255,255,255,.93),rgba(252,251,247,.9))}.device-peek{opacity:.35}}
@media(max-width:700px){.device{border-radius:34px;padding-inline:var(--s5)}.preview-tabs button{padding-inline:var(--s3)}}
@media(prefers-reduced-motion:reduce){.seg-lens{will-change:auto}}
</style>
