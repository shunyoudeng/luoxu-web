---
const categories=[{key:'task',label:'任务',heading:'今天需要处理',items:[['15:00','拿快递','今天 · 未完成'],['18:00','提交团日活动材料','PDF + 3张活动照片']]},{key:'assignment',label:'作业',heading:'学习上的几件事',items:[['20:00','高等数学作业','今晚截止 · 待提交'],['周五','大学物理实验报告','课程作业 · 未完成']]},{key:'opportunity',label:'机会',heading:'值得你留意',items:[['10.15','大学生创新竞赛报名','与你的科创兴趣相关'],['本周','实验室本科生招募','可选择参加 · 科研']]},{key:'info',label:'校园信息',heading:'校园里的变化',items:[['23:00','工学部今晚停水','至次日06:00 · 工学部'],['周六','图书馆开放时间调整','关注开放时间变化']]}];
---
<div class="product-preview" data-preview><div class="preview-tabs" role="tablist" aria-label="查看四类事务功能示意">{categories.map((c,i)=><button type="button" id={'tab-'+c.key} role="tab" aria-selected={i===0?'true':'false'} aria-controls={'panel-'+c.key} tabindex={i===0?0:-1} data-key={c.key}>{c.label}</button>)}</div>
<div class="device"><div class="device-top"><span>09:41</span><span class="device-island" aria-hidden="true"></span><span>功能示意</span></div><div class="device-brand"><span class="song">珞序</span><small>LUOXU</small><span class="device-date">10 / 09</span></div><p class="device-phrase kai">山色有远近，今日有轻重。</p>
<div class="preview-panels">{categories.map((c,i)=><div id={'panel-'+c.key} role="tabpanel" aria-labelledby={'tab-'+c.key} tabindex="0" hidden={i!==0}><h3>{c.heading}</h3>{c.items.map(([time,title,note],j)=><div class:list={['preview-item',{focus:j===0}]}><span class="item-time">{time}</span><div><h4>{title}</h4><p>{note}</p></div></div>)}<div class="preview-assistant"><span>珞序</span><p>{c.key==='task'?'“有什么快截止了？”':c.key==='assignment'?'“这周还有什么作业？”':c.key==='opportunity'?'“最近有哪些科研竞赛？”':'“今天校园有什么变化？”'}</p></div></div>)}
</div><div class="device-bottom"><span>首页</span><span>事务</span><span>AI秘书</span><span>数据箱</span><span>我的</span></div></div><p class="preview-caption">功能示意 · 非当前版本截图</p></div>
<script>
const preview=document.querySelector<HTMLElement>('[data-preview]');
if(preview){const tabs=Array.from(preview.querySelectorAll<HTMLButtonElement>('[role=tab]'));const select=(tab:HTMLButtonElement)=>{tabs.forEach(t=>{const on=t===tab;t.setAttribute('aria-selected',String(on));t.tabIndex=on?0:-1;const panel=document.getElementById(t.getAttribute('aria-controls')||'');if(panel)panel.hidden=!on;});};tabs.forEach((tab,index)=>{tab.addEventListener('click',()=>select(tab));tab.addEventListener('keydown',event=>{let next=index;if(event.key==='ArrowRight')next=(index+1)%tabs.length;else if(event.key==='ArrowLeft')next=(index-1+tabs.length)%tabs.length;else if(event.key==='Home')next=0;else if(event.key==='End')next=tabs.length-1;else return;event.preventDefault();select(tabs[next]);tabs[next].focus();});});}
</script>
<style>
.product-preview{width:100%;max-width:372px;margin-inline:auto;text-align:left}
.preview-tabs{display:flex;gap:var(--s1);padding:var(--s1);margin:0 auto var(--s6);width:fit-content;max-width:100%;border-radius:999px;background:rgba(255,254,251,.78);border:var(--stroke) solid var(--line);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px)}
.preview-tabs button{border:0;background:none;min-height:44px;padding:var(--s2) var(--s4);font-size:var(--label);font-weight:500;color:var(--secondary);border-radius:999px;border-bottom:0;white-space:nowrap;transition:background-color var(--motion-standard) var(--ease-standard),color var(--motion-standard) var(--ease-standard)}
.preview-tabs [aria-selected=true]{background:var(--green);color:var(--paper)}
@media(hover:hover) and (pointer:fine){.preview-tabs [aria-selected=true]:hover{color:var(--paper)}}
.device{position:relative;background:linear-gradient(180deg,var(--surface),#FAF9F4);border:var(--stroke) solid var(--line);border-radius:40px;padding:var(--s6) var(--s6) var(--s5);min-height:480px;box-shadow:var(--shadow-lift),inset 0 0 0 6px rgba(255,254,251,.9),inset 0 0 0 7px var(--line)}
.preview-panels{display:grid}
.preview-panels > [role=tabpanel]{grid-area:1/1;min-width:0;opacity:1;transition:opacity var(--motion-emphasized) var(--ease-out)}
.preview-panels > [hidden]{display:block;visibility:hidden;pointer-events:none;opacity:0;transition:none}
.device-top{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;font:var(--caption) var(--serif);font-variant-numeric:tabular-nums;color:var(--secondary);margin:var(--s1) var(--s2) var(--s6)}
.device-top span:last-child{text-align:right}
.device-island{width:64px;height:20px;border-radius:999px;background:var(--ink)}
.device-brand{display:flex;gap:var(--s3);align-items:baseline;font-size:1.75rem;font-weight:800;line-height:1.2;padding-inline:var(--s2)}
.device-brand .song{font-weight:900}
.device-brand small{font:italic var(--caption) var(--serif);letter-spacing:.14em;color:var(--green)}
.device-date{margin-left:auto;font:italic 400 var(--title) var(--serif);color:var(--green)}
.device-phrase{font-size:var(--small);color:var(--secondary);margin-top:var(--s2);padding-inline:var(--s2)}
[role=tabpanel] h3{font-size:var(--small);font-weight:600;letter-spacing:.04em;margin-block:var(--s6) var(--s3);padding-inline:var(--s2)}
.preview-item{display:flex;align-items:flex-start;gap:var(--s4);padding:var(--s3) var(--s4);border-radius:var(--r3);margin-bottom:var(--s1)}
.preview-item.focus{background:var(--mist)}
.item-time{font:italic var(--small)/1.7 var(--serif);font-variant-numeric:tabular-nums;color:var(--green);min-width:44px}
.preview-item h4{font-size:var(--small);font-weight:600;margin:0}
.preview-item p{font-size:var(--caption);color:var(--secondary);margin-top:var(--s1)}
.preview-assistant{margin-top:var(--s5);margin-inline:var(--s2);padding:var(--s3) var(--s4);border-radius:var(--r3) var(--r3) var(--r3) var(--s1);background:var(--green);color:var(--paper);font-size:var(--caption)}
.preview-assistant span{font-family:var(--song);font-weight:900;color:var(--mint)}
.preview-assistant p{margin-top:var(--s1);color:var(--paper);font-size:var(--small)}
.device-bottom{display:flex;justify-content:space-between;border-top:var(--stroke) solid var(--line);padding:var(--s4) var(--s2) 0;margin-top:var(--s6);font-size:var(--caption);color:var(--secondary)}
.device-bottom span:first-child{color:var(--green);font-weight:600}
.preview-caption{margin-top:var(--s4);font-size:var(--caption);color:var(--secondary);text-align:center;letter-spacing:.04em}
@media(max-width:700px){.device{border-radius:34px;padding-inline:var(--s5)}.preview-tabs button{padding-inline:var(--s3)}}
</style>
