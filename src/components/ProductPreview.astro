---
const categories=[{key:'task',label:'任务',heading:'今天需要处理',items:[['15:00','拿快递','今天 · 未完成'],['18:00','提交团日活动材料','PDF + 3张活动照片']]},{key:'assignment',label:'作业',heading:'学习上的几件事',items:[['20:00','高等数学作业','今晚截止 · 待提交'],['周五','大学物理实验报告','课程作业 · 未完成']]},{key:'opportunity',label:'机会',heading:'值得你留意',items:[['10.15','大学生创新竞赛报名','与你的科创兴趣相关'],['本周','实验室本科生招募','可选择参加 · 科研']]},{key:'info',label:'校园信息',heading:'校园里的变化',items:[['23:00','工学部今晚停水','至次日06:00 · 工学部'],['周六','图书馆开放时间调整','关注开放时间变化']]}];
---
<div class="product-preview" data-preview><div class="preview-tabs" role="tablist" aria-label="查看四类事务功能示意">{categories.map((c,i)=><button type="button" id={'tab-'+c.key} role="tab" aria-selected={i===0?'true':'false'} aria-controls={'panel-'+c.key} tabindex={i===0?0:-1} data-key={c.key}>{c.label}</button>)}</div>
<div class="device"><div class="device-top"><span>09:41</span><span>功能示意</span></div><div class="device-brand"><span>珞序</span><small>LUOXU</small><span class="device-date">10 / 09</span></div><p class="device-phrase">山色有远近，今日有轻重。</p>
<div class="preview-panels">{categories.map((c,i)=><div id={'panel-'+c.key} role="tabpanel" aria-labelledby={'tab-'+c.key} tabindex="0" hidden={i!==0}><h3>{c.heading}</h3>{c.items.map(([time,title,note],j)=><div class:list={['preview-item',{focus:j===0}]}><span class="item-time">{time}</span><div><h4>{title}</h4><p>{note}</p></div></div>)}<div class="preview-assistant"><span>珞序</span><p>{c.key==='task'?'“有什么快截止了？”':c.key==='assignment'?'“这周还有什么作业？”':c.key==='opportunity'?'“最近有哪些科研竞赛？”':'“今天校园有什么变化？”'}</p></div></div>)}
</div><div class="device-bottom"><span>首页</span><span>事务</span><span>AI秘书</span><span>数据箱</span><span>我的</span></div></div><p class="preview-caption">功能示意 · 非当前版本截图</p></div>
<script>
const preview=document.querySelector<HTMLElement>('[data-preview]');
if(preview){const tabs=Array.from(preview.querySelectorAll<HTMLButtonElement>('[role=tab]'));const select=(tab:HTMLButtonElement)=>{tabs.forEach(t=>{const on=t===tab;t.setAttribute('aria-selected',String(on));t.tabIndex=on?0:-1;const panel=document.getElementById(t.getAttribute('aria-controls')||'');if(panel)panel.hidden=!on;});};tabs.forEach((tab,index)=>{tab.addEventListener('click',()=>select(tab));tab.addEventListener('keydown',event=>{let next=index;if(event.key==='ArrowRight')next=(index+1)%tabs.length;else if(event.key==='ArrowLeft')next=(index-1+tabs.length)%tabs.length;else if(event.key==='Home')next=0;else if(event.key==='End')next=tabs.length-1;else return;event.preventDefault();select(tabs[next]);tabs[next].focus();});});}
</script>
<style>.product-preview{width:100%;max-width:340px;margin-inline:auto}.preview-tabs{display:flex;justify-content:space-between;border-bottom:var(--stroke) solid var(--line);margin-bottom:var(--s6)}.preview-tabs button{border:0;background:none;min-height:48px;padding:var(--s2);font-size:var(--label);color:var(--secondary);border-bottom:var(--stroke) solid transparent}.preview-tabs [aria-selected=true]{color:var(--green);border-color:var(--green)}.device{background:var(--surface);border:var(--stroke) solid var(--line);border-radius:var(--r3);padding:var(--s6);min-height:400px}.preview-panels{display:grid}.preview-panels > [role=tabpanel]{grid-area:1/1;min-width:0}.preview-panels > [hidden]{display:block;visibility:hidden;pointer-events:none}.device-top{display:flex;justify-content:space-between;font-size:var(--caption);color:var(--secondary);margin-bottom:var(--s6)}.device-brand{display:flex;gap:var(--s3);align-items:baseline;font-size:var(--title)}.device-brand small{font:var(--caption) var(--serif);letter-spacing:.08em;color:var(--green)}.device-date{margin-left:auto;font:var(--title) var(--serif);color:var(--green)}.device-phrase{font-size:var(--caption);color:var(--secondary);margin-top:var(--s2)}[role=tabpanel] h3{font-size:var(--small);font-weight:500;margin-block:var(--s6) var(--s4)}.preview-item{display:flex;align-items:flex-start;gap:var(--s4);padding:var(--s4) 0;border-bottom:var(--stroke) solid var(--line)}.preview-item.focus{padding:var(--s4);background:var(--mist);border:0;border-radius:var(--r2);margin-bottom:var(--s2)}.item-time{font-variant-numeric:tabular-nums;font:var(--small)/1.7 var(--serif);color:var(--green);min-width:44px}.preview-item h4{font-size:var(--small);font-weight:500;margin:0}.preview-item p{font-size:var(--caption);color:var(--secondary);margin-top:var(--s1)}.preview-assistant{margin-top:var(--s6);font-size:var(--caption);color:var(--secondary)}.preview-assistant span{color:var(--green)}.preview-assistant p{margin-top:var(--s2)}.device-bottom{display:flex;justify-content:space-between;border-top:var(--stroke) solid var(--line);padding-top:var(--s4);margin-top:var(--s6);font-size:var(--caption);color:var(--secondary)}.device-bottom span:first-child{color:var(--green)}.preview-caption{margin-top:var(--s3);font-size:var(--caption);color:var(--secondary);text-align:center}</style>
