---
import {withBase,releaseHref} from '../lib/urls';
import {latest,formatBytes,formatDate} from '../lib/releases';
import Icon from './Icon.astro';
import GitHubLink from './GitHubLink.astro';
interface Props {compact?:boolean}
const {compact=false}=Astro.props;
const highlights:string[]=compact?latest.highlights.slice(0,3):latest.highlights;
---
<div class:list={['release-panel',{compact}]}><div class="release-title"><div><span class="status">Android · {latest.channel}</span><h3>珞序 v{latest.version}</h3></div><span class="release-stage">{latest.status==='candidate'?'预览版':'公测版'}</span></div>
<dl class="release-meta"><div><dt>适用系统</dt><dd>Android {latest.minimumAndroid} 及以上</dd></div><div><dt>安装包</dt><dd>{formatBytes(latest.sizeBytes)}</dd></div><div><dt>{latest.releaseDate?'发布日期':'版本日期'}</dt><dd>{formatDate(latest.releaseDate||latest.buildDate)}</dd></div></dl>
<div class="release-highlights"><h4>本次更新</h4><ul>{highlights.map(line=><li>{line}</li>)}</ul></div><div class="actions">{latest.downloadUrl?<a class="button primary apk-download" href={releaseHref(latest.downloadUrl)} download>下载 APK <Icon name="download"/></a>:<span class="button disabled" aria-disabled="true">安装包准备中</span>}{compact?<a class="text-link" href={withBase("/download")}>下载与安装说明 <Icon/></a>:<GitHubLink releases/>}</div>{!compact&&<><a class="text-link" href={releaseHref(latest.changelogUrl)}>查看完整更新日志 <Icon/></a><details class="checksum"><summary>校验安装包（SHA-256）</summary><p>下载后可用这串校验值确认安装包完整、未被改动。</p><code>{latest.sha256||'安装包准备后提供校验值'}</code></details></>}
</div>
<style>.release-panel{border:var(--stroke) solid var(--line);padding:var(--s8);background:var(--surface);border-radius:32px;box-shadow:var(--shadow-soft)}.release-title{display:flex;justify-content:space-between;align-items:center;gap:var(--s4)}.release-title h3{font-size:1.75rem;font-weight:800;letter-spacing:-.015em}.release-stage{font-size:var(--caption);font-weight:500;color:var(--green);background:var(--mist);padding:var(--s1) var(--s3);border-radius:999px;white-space:nowrap}.release-meta{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--s6);margin-block:var(--s8);padding-block:var(--s6);border-block:var(--stroke) solid var(--line)}dt{font-size:var(--caption);color:var(--secondary)}dd{font-variant-numeric:tabular-nums;font-size:var(--small);margin-top:var(--s1)}.release-highlights{margin-bottom:var(--s6)}.release-highlights h4{font-size:var(--label);font-weight:500;color:var(--green);margin-bottom:var(--s2)}.release-highlights ul{margin:0;padding-left:var(--s5);font-size:var(--small);color:var(--secondary)}.release-highlights li{margin-block:var(--s1)}.checksum{margin-top:var(--s4);font-size:var(--caption);color:var(--secondary)}.checksum p{margin-bottom:var(--s2)}.checksum summary{min-height:48px;cursor:pointer;display:flex;align-items:center}.checksum code{display:block;overflow-wrap:anywhere;font-size:var(--caption);padding:var(--s4);background:var(--paper)}@media(max-width:700px){.release-panel{padding:var(--s6)}.release-title{align-items:flex-start;flex-direction:column;gap:var(--s2)}.release-meta{grid-template-columns:1fr;gap:var(--s4);margin-block:var(--s6)}.release-meta div{display:flex;justify-content:space-between;gap:var(--s4)}dd{margin-top:0}.release-panel .actions{align-items:stretch;flex-direction:column}.release-stage{font-size:var(--caption)}}</style>
