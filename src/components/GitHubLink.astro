---
import {site} from '../lib/site';
import Icon from './Icon.astro';
interface Props { releases?: boolean; label?: string }
const {releases=false,label=releases?'GitHub Releases':'GitHub · 查看源代码'}=Astro.props;
const url=releases?site.githubReleases:site.github;
---
{url?<a class="button secondary" href={url} target="_blank" rel="noopener noreferrer"><Icon name="github"/>{label}</a>:<span class="button disabled" aria-disabled="true">{releases?'Releases 链接暂不可用':'GitHub 链接暂不可用'}</span>}
