---
import {withBase,stripBase,absoluteUrl} from '../lib/urls';
import '../styles/global.css';
import Brand from '../components/Brand.astro';
import Icon from '../components/Icon.astro';
import {site,description as defaultDescription} from '../lib/site';
interface Props {title?:string;description?:string;noindex?:boolean}
const {title='珞序 LUOXU — 校园 AI 助手',description=defaultDescription,noindex=false}=Astro.props;
const pathname=stripBase(Astro.url.pathname).replace(/\/$/,'')||'/';
const canonical=absoluteUrl(pathname);
const links=[['/','产品'],['/download','下载'],['/changelog','更新'],['/about','关于']];
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#F7F6F2"/><title>{title}</title><meta name="description" content={description}/><meta name="robots" content={noindex||!site.siteUrl?'noindex, nofollow':'index, follow'}/>{canonical&&<link rel="canonical" href={canonical}/>}
<meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:locale" content="zh_CN"/><meta property="og:site_name" content="珞序 LUOXU"/>{canonical&&<><meta property="og:url" content={canonical}/><meta property="og:image" content={absoluteUrl('/images/og.png')}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content="珞序 LUOXU：让校园信息，自成秩序。"/></>}<meta name="twitter:card" content="summary_large_image"/><link rel="icon" href={withBase("/icons/luoxu.svg")} type="image/svg+xml"/><link rel="icon" href={withBase("/icons/favicon-32.png")} sizes="32x32"/><link rel="apple-touch-icon" href={withBase("/icons/apple-touch-icon.png")}/><link rel="manifest" href={withBase("/manifest.webmanifest")}/></head>
<body><a class="skip-link" href="#main">跳到正文</a><header class="site-header"><div class="wrap header-inner"><Brand/><nav class="desktop-nav" aria-label="主导航">{links.map(([href,label])=><a class="nav-link" href={withBase(href)} aria-current={pathname===href?'page':undefined}>{label}</a>)}<a class="button primary" href={withBase("/download")}>Android 内测 <Icon name="download" size={16}/></a></nav><details class="mobile-menu"><summary aria-label="打开网站导航">菜单 <Icon name="menu"/></summary><nav aria-label="移动导航">{links.map(([href,label])=><a class="nav-link" href={withBase(href)} aria-current={pathname===href?'page':undefined}>{label}</a>)}<a class="nav-link" href={withBase("/privacy")}>隐私说明</a><a class="nav-link" href={withBase("/download")}>下载 Android</a></nav></details></div></header>
<main id="main"><slot/></main>
<footer class="site-footer"><div class="wrap"><div class="footer-top"><div class="footer-brand"><Brand/><p>让校园信息，自成秩序。</p></div><nav class="footer-links" aria-label="页脚导航"><a href={withBase("/download")}>下载</a><a href={withBase("/changelog")}>更新日志</a><a href={withBase("/privacy")}>隐私</a><a href={withBase("/terms")}>使用说明</a><a href={withBase("/about#feedback")}>反馈</a>{site.github&&<a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>}</nav></div><div class="footer-note"><span>Designed and built by 水逝楚云</span><span>独立校园产品 · 非武汉大学官方产品</span></div>{(site.icp||site.policeRecord)&&<div class="footer-note">{site.icp&&<a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">{site.icp}</a>}{site.policeRecord&&(site.policeUrl?<a href={site.policeUrl} target="_blank" rel="noopener noreferrer">{site.policeRecord}</a>:<span>{site.policeRecord}</span>)}</div>}</div></footer>
</body></html>
