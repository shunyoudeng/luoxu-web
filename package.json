{
  "name": "luoxu-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/astro.mjs dev --host 127.0.0.1",
    "check": "node scripts/astro.mjs check",
    "build": "node scripts/check-release.mjs && node scripts/astro.mjs build",
    "preview": "node scripts/astro.mjs preview --host 127.0.0.1",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:e2e": "playwright test",
    "release:apk": "node scripts/update-apk.mjs",
    "verify": "npm run check && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "1.64.0",
    "@types/node": "^24.19.1",
    "typescript": "~5.9.3"
  }
}
